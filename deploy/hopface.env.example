# Salin ke /etc/project-app1/hopface.env (izin 600, milik root).
HOPFACE_ADDR=:8868
# Alamat publik situs; dipakai untuk redirect URI Google dan menentukan cookie Secure (https).
HOPFACE_BASE_URL=http://localhost:8868
HOPFACE_DATA=/var/lib/hopface
# Wajib: acak, minimal 16 karakter (install.sh membuatnya otomatis).
HOPFACE_SESSION_SECRET=GANTI_DENGAN_ACAK
# Email admin (pisahkan koma) yang boleh membuka halaman /admin.
HOPFACE_ADMIN_EMAILS=
# JANGAN set HOPFACE_DEV=1 di server yang bisa diakses publik: itu membuka login palsu untuk siapa saja.
